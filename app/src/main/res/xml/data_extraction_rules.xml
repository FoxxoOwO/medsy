<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaced allowBackup with per-path rules. Nothing leaves the device:
     the database is encrypted, the export format is opt-in, and cloud/device-transfer
     copies would bypass both. Keep this in sync with allowBackup/fullBackupContent. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

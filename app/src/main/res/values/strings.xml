    <string name="bloodwork_hold_morning_detail">Taking tablets/injections before venipuncture artificially raises measured levels. Take the dose after the blood draw unless your doctor says otherwise.</string>
    <string name="bloodwork_fast_title">Fast if the lab asked for it</string>

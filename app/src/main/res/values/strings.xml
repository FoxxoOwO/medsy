    <string name="interaction_warfarin_aspirin_nsaid_title">Warfarin + aspirin/NSAID</string>
    <string name="interaction_warfarin_aspirin_nsaid_detail">Markedly increased bleeding risk. Only under explicit haematology supervision.</string>
    <string name="interaction_spironolactone_ace_arb_title">Spironolactone + ACE inhibitor/ARB</string>
    <string name="interaction_spironolactone_ace_arb_detail">Additive hyperkalaemia risk. Monitor potassium, especially after dose changes.</string>
    <string name="interaction_spironolactone_loop_title">Spironolactone + loop diuretic</string>
    <string name="interaction_spironolactone_loop_detail">Potassium can swing either way; check electrolytes after changes.</string>
    <string name="interaction_estradiol_spironolactone_title">Estradiol + spironolactone</string>
    <string name="interaction_estradiol_spironolactone_detail">Commonly combined. Watch potassium and renal function.</string>
    <string name="interaction_levothyroxine_ppi_title">Levothyroxine + proton-pump inhibitor</string>
    <string name="interaction_levothyroxine_ppi_detail">Reduced levothyroxine absorption. Separate intake by at least 4 h and recheck TSH.</string>
    <string name="interaction_levothyroxine_minerals_title">Levothyroxine + calcium/iron/magnesium</string>
    <string name="interaction_levothyroxine_minerals_detail">Chelation reduces levothyroxine absorption. Separate by at least 4 h.</string>
    <string name="interaction_iron_antacid_title">Iron + antacid/calcium</string>
    <string name="interaction_iron_antacid_detail">Reduced iron absorption. Separate by at least 2 h.</string>
    <string name="interaction_oestrogen_warfarin_title">Oestrogen + warfarin</string>
    <string name="interaction_oestrogen_warfarin_detail">Oestrogens can reduce anticoagulant effect. INR monitoring needed.</string>
    <string name="interaction_statin_azole_title">Statin + azole/antifungal or macrolide</string>
    <string name="interaction_statin_azole_detail">CYP3A4 inhibition raises statin exposure — myopathy/rhabdomyolysis risk.</string>
    <string name="interaction_antiviral_steroid_title">Some antivirals + corticosteroids</string>
    <string name="interaction_antiviral_steroid_detail">Class-specific interactions exist; check the individual substance.</string>
    <string name="interaction_steroid_potassium_title">Steroid + potassium-rich diet</string>
    <string name="interaction_steroid_potassium_detail">Corticosteroids lower potassium; watch bananas, potatoes, beans, and recheck K.</string>
    <string name="interaction_spiro_potassium_title">Potassium-rich diet with spironolactone</string>
    <string name="interaction_spiro_potassium_detail">Spironolactone is potassium-sparing. Avoid salt substitutes (KCl) and large potassium loads.</string>
    <string name="interaction_statin_grapefruit_title">Statins + grapefruit</string>
    <string name="interaction_statin_grapefruit_detail">Grapefruit inhibits CYP3A4 and raises statin exposure — risk of myopathy. Avoid.</string>
    <string name="interaction_antiandrogen_photo_title">Photosensitivity</string>
    <string name="interaction_antiandrogen_photo_detail">Antiandrogens can increase sun sensitivity. Use SPF, check the UV index before long exposure.</string>
    <string name="interaction_alcohol_sedation_title">Alcohol and sedation</string>
    <string name="interaction_alcohol_sedation_detail">Alcohol increases sedation and, with SSRIs, GI bleeding risk. Keep intake low.</string>
    <string name="interaction_alcohol_paracetamol_title">Paracetamol/opioid + alcohol</string>
    <string name="interaction_alcohol_paracetamol_detail">Alcohol amplifies liver stress (paracetamol) and CNS depression (tramadol).</string>
    <string name="interaction_warfarin_stjohns_title">Warfarin + St John’s Wort</string>
    <string name="interaction_warfarin_stjohns_detail">St John’s Wort induces CYP and lowers INR unpredictably. Avoid.</string>
    <string name="interaction_calcium_dairy_title">Calcium + dairy</string>
    <string name="interaction_calcium_dairy_detail">Large dairy servings stack with calcium supplements; spread intake across the day.</string>
    <string name="interaction_magnesium_dairy_title">Magnesium + dairy/antacids</string>
    <string name="interaction_magnesium_dairy_detail">Magnesium salts bind dietary calcium; keep supplement and dairy apart.</string>
    <string name="interaction_iron_coffee_title">Iron + coffee/tea</string>
    <string name="interaction_iron_coffee_detail">Polyphenols in coffee and tea cut iron absorption. Take iron with vitamin C and water.</string>
    <string name="interaction_oestrogen_stjohns_title">Oestrogen + St John’s Wort</string>
    <string name="interaction_oestrogen_stjohns_detail">St John’s Wort induces CYP3A4 and can reduce oestrogen levels.</string>
    <string name="interaction_oestrogen_smoking_title">Oestrogen and smoking</string>
    <string name="interaction_oestrogen_smoking_detail">Combined with smoking, oestrogens raise venous thromboembolism risk. Stopping smoking matters more than any dose adjustment.</string>
    <string name="interaction_separate_intake">Separate intake: %1$s</string>
    <string name="interaction_absorption_iron_calcium">Separate iron from calcium/magnesium by at least 2 hours to preserve absorption.</string>
    <string name="interaction_absorption_levothyroxine">Separate levothyroxine from iron/calcium by at least 4 hours.</string>
